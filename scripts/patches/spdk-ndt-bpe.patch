+static key_t
+bpe_slot_segment_key(bool is_read, uint32_t slot, uint32_t bank)
+{
+    key_t base = is_read ? (bank == 0 ? SHM_READ_KEY : SHM_READ_KEY_BANK1)
+                         : (bank == 0 ? SHM_WRITE_KEY : SHM_WRITE_KEY_BANK1);
+    return base + slot;

+static int
+bpe_connect_eventfds(void)
+{
+    int sock_fd = socket(AF_UNIX, SOCK_SEQPACKET, 0);
+    if (sock_fd < 0) {
+        SPDK_ERRLOG("socket(AF_UNIX) failed: %s\n", spdk_strerror(errno));
+        return -1;
+    }
+
+    struct sockaddr_un addr = {};
+    addr.sun_family = AF_UNIX;
+    snprintf(addr.sun_path, sizeof(addr.sun_path), "%s", EVENTFD_SOCKET_PATH);
+
+    for (int attempt = 0; attempt < 100; ++attempt) {
+        if (connect(sock_fd, (struct sockaddr *)&addr, sizeof(addr)) == 0) {
+            for (uint32_t slot = 0; slot < NUM_SLOTS; ++slot) {
+                struct bpe_eventfd_msg msg = {};
+                if (bpe_recv_slot_fds(sock_fd, &msg, &g_req_eventfd[slot], &g_cpl_eventfd[slot]) != 0) {
+                    SPDK_ERRLOG("failed to receive eventfds for slot %u\n", slot);
+                    close(sock_fd);
+                    return -1;
+                }
+                if (msg.slot != slot) {
+                    SPDK_ERRLOG("eventfd handshake slot mismatch: expected %u got %u\n",
+                                slot, msg.slot);
+                    close(sock_fd);
+                    return -1;
+                }
+            }
+            close(sock_fd);
+            return 0;
+        }
+        if (errno != ENOENT && errno != ECONNREFUSED) {
+            SPDK_ERRLOG("connect(%s) failed: %s\n", EVENTFD_SOCKET_PATH, spdk_strerror(errno));
+            close(sock_fd);
+            return -1;
+        }
+        usleep(100000);
+    }
+
+    SPDK_ERRLOG("timed out waiting for runtime eventfd handshake on %s\n", EVENTFD_SOCKET_PATH);
+    close(sock_fd);
+    return -1;
+}

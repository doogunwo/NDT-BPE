+            g_tickets[i].local_buf = local_buf;
+            g_tickets[i].local_buf_len = local_buf_len;
+            g_tickets[i].deadline_tsc = deadline;
+            spdk_spin_unlock(&g_ticket_lock);
+            return true;
+        }
+    }
+    spdk_spin_unlock(&g_ticket_lock);
+    return false;
+}
+
+
+static bool bpe_ticket_take(uint64_t req_id, struct bpe_ticket *ticket)
+{
+    bool found = false;
+    spdk_spin_lock(&g_ticket_lock);
+    for (int i = 0; i < BPE_MAX_TICKETS; i++) {
+        if (g_tickets[i].in_use && g_tickets[i].req_id == req_id) {
+            *ticket = g_tickets[i];
+            g_tickets[i].in_use = false;
+            found = true;
+            break;
+        }
+    }
+    spdk_spin_unlock(&g_ticket_lock);
+    return found;
+}
+
+static void bpe_ticket_timeout_sweep(void)
+{
+    uint64_t now = ticks_now();
+    struct bpe_ticket expired[128];
+    int n = 0;
+
+    spdk_spin_lock(&g_ticket_lock);
+    for (int i = 0; i < BPE_MAX_TICKETS && n < (int)(sizeof(expired)/sizeof(expired[0])); i++) {
+        if (g_tickets[i].in_use && g_tickets[i].deadline_tsc <= now) {
+            expired[n++] = g_tickets[i];
+            g_tickets[i].in_use = false;
+        }
+    }
+    spdk_spin_unlock(&g_ticket_lock);
+
+    for (int i = 0; i < n; i++) {
+        struct spdk_nvmf_request *req = expired[i].req;
+        bpe_mark_bank_free(expired[i].slot, expired[i].bank);
+        spdk_free(expired[i].local_buf);
+        struct spdk_nvme_cpl *rsp = &req->rsp->nvme_cpl;
+        rsp->status.sct = SPDK_NVME_SCT_GENERIC;
+        rsp->status.sc  = SPDK_NVME_SC_INTERNAL_DEVICE_ERROR;
+        spdk_nvmf_request_complete(req);
+    }
+}
+
+static void
+nvmf_bdev_ctrlr_bpe_write_complete(struct spdk_bdev_io *bdev_io, bool success, void *cb_arg)
+{
+        struct bpe_write_ctx *ctx = cb_arg;
+        struct spdk_nvmf_request *req = ctx->req;
+        struct spdk_nvme_cpl *response = &req->rsp->nvme_cpl;
+        int sc = 0, sct = 0;
+        uint32_t cdw0 = 0;
+
+        spdk_bdev_io_get_nvme_status(bdev_io, &cdw0, &sct, &sc);
+        response->cdw0 = cdw0;
+        response->status.sc = sc;
+        response->status.sct = sct;
+        SPDK_NOTICELOG("BPE local write complete: slot=%u success=%d sct=%d sc=%d\n",
+                       req->cmd->nvme_cmd.cdw13 % NUM_SLOTS, success ? 1 : 0, sct, sc);
+        spdk_free(ctx->local_buf);
+        free(ctx);
+        spdk_nvmf_request_complete(req);
+        spdk_bdev_free_io(bdev_io);
+}
+
+static int
+bpe_send_request_nb(uint32_t slot, uint32_t bank)
+{
+    __sync_synchronize();
+    bpe_mark_bank_ready(slot, bank);
+    if (bpe_signal_eventfd(g_req_eventfd[slot]) != 0) {
+        return -1;
+    }
+    return 0;
+}

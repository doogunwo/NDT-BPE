+static int
+bpe_signal_eventfd(int fd)
+{
+    uint64_t value = 1;
+
+    for (;;) {
+        ssize_t rc = write(fd, &value, sizeof(value));
+        if (rc == (ssize_t)sizeof(value)) {
+            return 0;
+        }
+        if (rc < 0 && errno == EINTR) {
+            continue;
+        }
+        SPDK_ERRLOG("eventfd write failed: %s\n", spdk_strerror(errno));
+        return -1;
+    }
+}

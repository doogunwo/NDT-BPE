+static void bpe_ipc_init_once(void)
+{
+    static bool inited = false;
+    if (inited) return;
+    bpe_ticket_init_once();
+    g_ipc_cfg = bpe_attach_ipc_config();
+    g_ipc_state = bpe_attach_ipc_state();
+    if (g_ipc_cfg == NULL || g_ipc_state == NULL) {
+        abort();
+    }
+
+    for (uint32_t s = 0; s < NUM_SLOTS; s++) {
+        for (uint32_t bank = 0; bank < NUM_BUFFERS; ++bank) {
+            g_shm_read[s][bank] = bpe_attach_slot_segment(bpe_slot_segment_key(true, s, bank), s, bank, "read");
+            g_shm_write[s][bank] = bpe_attach_slot_segment(bpe_slot_segment_key(false, s, bank), s, bank, "write");
+            if (g_shm_read[s][bank] == NULL || g_shm_write[s][bank] == NULL) {
+                abort();
+            }
+        }
+        g_req_eventfd[s] = -1;
+        g_cpl_eventfd[s] = -1;
+        g_next_bank[s] = 0;
+    }
+
+    if (bpe_connect_eventfds() != 0) {
+        abort();
+    }
+
+    inited = true;
+}

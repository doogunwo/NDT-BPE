+static int
+bpe_drain_eventfd(int fd, uint64_t *count_out)
+{
+    uint64_t total = 0;
+
+    for (;;) {
+        uint64_t value = 0;
+        ssize_t rc = read(fd, &value, sizeof(value));
+        if (rc == (ssize_t)sizeof(value)) {
+            total += value;
+            continue;
+        }
+        if (rc < 0 && errno == EINTR) {
+            continue;
+        }
+        if (rc < 0 && errno == EAGAIN) {
+            break;
+        }
+        if (rc == 0) {
+            break;
+        }
+        SPDK_ERRLOG("eventfd read failed: %s\n", spdk_strerror(errno));
+        return -1;
+    }
+
+    *count_out = total;
+    return 0;
+}
